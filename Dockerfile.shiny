# syntax=docker/dockerfile:1
# BuildKit required for cache mounts. In CI, set DOCKER_BUILDKIT=1 before docker build.
FROM rocker/shiny:4.4.1

# Install system dependencies (cache mount speeds repeated builds)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libudunits2-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy renv files first (for package installation cache)
COPY ./aqbat/renv.lock /app/renv.lock
COPY ./aqbat/renv /app/renv
COPY ./aqbat/.Rprofile /app/.Rprofile

# Install renv and restore packages; cache mount reuses R package cache across builds
RUN R -e "install.packages('renv', repos='https://cloud.r-project.org')"
RUN --mount=type=cache,target=/root/.local/share/renv/cache,sharing=locked \
    R -e "renv::restore()"

# Copy app files (after renv restore to preserve package layer cache)
COPY ./aqbat/ /app/

EXPOSE 3838

CMD ["R", "-e", "shiny::runApp('/app', port=3838, host='0.0.0.0')"]
